#!/bin/bash
# Enterprise HR RAG Platform - Common Configuration

# Region
export REGION="asia-south1"
export ZONE="asia-south1-a"
export PROJECT_PREFIX="hr-rag"
export REGISTRY_LOCATION="asia-south1"
export REGISTRY_NAME="hr-rag-repo"
export RAG_ENGINE_NAME="hr-rag-engine"
export UI_NAME="hr-rag-ui"

# RAG Config
export CHUNK_SIZE="512"
export CHUNK_OVERLAP="50"
export TOP_K_DENSE="5"
export TOP_K_SPARSE="5"
export RERANKER_TOP_K="3"
export HYBRID_ALPHA="0.5"
export EMBEDDING_MODEL="text-embedding-004"
export LLM_MODEL="gemini-2.5-flash"
export VECTOR_DIMENSIONS="768"

# RAGAS Thresholds
export RAGAS_FAITHFULNESS_THRESHOLD="0.85"
export RAGAS_RELEVANCY_THRESHOLD="0.80"
export RAGAS_PRECISION_THRESHOLD="0.75"
export RAGAS_RECALL_THRESHOLD="0.70"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging functions
log_info()    { echo -e "${GREEN}[INFO]${NC}  $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC}  $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
log_step()    { echo -e "${BLUE}[STEP]${NC}  ===== $1 ====="; }
log_success() { echo -e "${GREEN}[OK]${NC}    $1"; }

# Idempotent helpers
project_exists() { gcloud projects describe "$1" &>/dev/null; }
service_exists() { gcloud services list --enabled --project="$2" --filter="name:$1" --format="value(name)" | grep -q "$1"; }
secret_exists()  { gcloud secrets describe "$1" --project="$2" &>/dev/null 2>&1; }
bucket_exists()  { gsutil ls -b "gs://$1" &>/dev/null 2>&1; }
